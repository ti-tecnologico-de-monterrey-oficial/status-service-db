{
  "name": "@digitalcredentials/status-service-db",
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env server.js",
    "dev": "node --watch --env-file-if-exists=.env server.js",
    "lt": "./localtunnel.sh",
    "test": "vitest run",
    "test:coverage": "npm test -- --coverage",
    "postinstall": "patch-package"
  },
  "dependencies": {
