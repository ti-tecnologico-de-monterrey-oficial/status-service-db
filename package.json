    "winston": "^3.19.0"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^5.0.5",
    "patch-package": "^8.0.1",
    "supertest": "^7.3.1",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "@digitalcredentials/http-client@1.2.2": {
      "ky-universal": {
        "ky": "0.25.1"
      }
    },
    "@digitalcredentials/credential-status-manager-db": {
      "uuid": "^11.1.1"
    },
    "@digitalcredentials/ed25519-verification-key-2020": {
